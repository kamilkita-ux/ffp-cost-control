# Skopiuj ten plik do .env i uzupełnij prawdziwym connection stringiem PostgreSQL.
# Format: postgresql://UZYTKOWNIK:HASLO@HOST:PORT/NAZWA_BAZY?schema=public

# Lokalnie / na własnym serwerze:
DATABASE_URL="postgresql://ffp_app:CHANGE_ME@localhost:5432/ffp_cost_control?schema=public"

# Przykład dla Neon / Supabase / Railway (managed Postgres) — dopisz też
# parametr sslmode=require, jeśli dostawca tego wymaga:
# DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/ffp_cost_control?sslmode=require"
